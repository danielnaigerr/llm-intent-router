# Required. The server has no local-model fallback - without a paid OpenAI
# key the chat, math word-problems, review analysis and review summarization
# endpoints all fail.
OPENAI_API_KEY=

# Required by Prisma (packages/server/prisma/schema.prisma) for the
# /api/products/:id/reviews endpoints. MySQL connection string.
DATABASE_URL="mysql://user:password@localhost:3306/chatbot"

# Optional. Express listen port, defaults to 3000.
# The Vite dev server proxies /api to http://localhost:3000.
PORT=3000
